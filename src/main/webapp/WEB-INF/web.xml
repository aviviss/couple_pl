<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>Couple Planner</display-name>

  <!-- Объявление сервлета -->
  <servlet>
    <servlet-name>servlet</servlet-name>
    <servlet-class>servlet</servlet-class>

    <!-- Параметры инициализации -->
    <init-param>
      <param-name>couple_name</param-name>
      <param-value>Aa и Bb</param-value>
    </init-param>
    <init-param>
      <param-name>app_version</param-name>
      <param-value>1.0.0</param-value>
    </init-param>
    <init-param>
      <param-name>default_category</param-name>
      <param-value>all</param-value>
    </init-param>
  </servlet>

  <!-- Маппинг URL к сервлету -->
  <servlet-mapping>
    <servlet-name>servlet</servlet-name>
    <url-pattern>/ActivityList</url-pattern>
  </servlet-mapping>

</web-app>